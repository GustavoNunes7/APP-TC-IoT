{
  "expo": {
    "name": "TechCampus IoT",
    "slug": "techcampus-iot",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "techcampusiot",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gustavonunes.techcampusiot",
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
